# ==============================================================================
# Mikella ERP — Configurações de Ambiente (Local-First)
# Copie este arquivo para .env para customizar sua instalação local.
# NUNCA comite o arquivo .env no Git!
# ==============================================================================

# Porta do servidor HTTP local (127.0.0.1)
MIKELLA_PORT=47823

# Caminho do banco de dados SQLite local
MIKELLA_DB_PATH=dados/loja.db

# Modo de e-mail / 2FA local (1 = exibe o código no console / resposta local para desenvolvimento)
MIKELLA_EMAIL_CONSOLE=1

# Nível de detalhamento dos logs (trace, debug, info, warn, error)
RUST_LOG=mikella_server=info,tower_http=info

# URL da API local consumida pela interface (Tauri / Web)
MIKELLA_API_URL=http://127.0.0.1:47823

# [OPCIONAL - PRODUÇÃO] Segredo mestre para geração do hash dos códigos 2FA (mínimo 32 caracteres)
# Se omitido, o servidor gera uma chave segura aleatória em memória a cada reinicialização
# MIKELLA_SEGREDO_2FA=insira_uma_chave_secreta_aleatoria_aqui
