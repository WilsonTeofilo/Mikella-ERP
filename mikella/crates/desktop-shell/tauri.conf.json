{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mikella",
  "version": "0.1.0",
  "identifier": "com.mikella.pos",
  "build": {
    "frontendDist": "../../frontend/src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mikella POS",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark",
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:47823 https://viacep.com.br https://brasilapi.com.br; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true
      },
      "capabilities": ["mikella-main"]
    }
  }
}
